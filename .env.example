# Docker Compose'u başlatmadan önce bu dosyayı .env adıyla kopyalayın.
# Gerçek .env dosyası git tarafından izlenmez ve kesinlikle commit edilmemelidir.
MSSQL_SA_PASSWORD=<kendinizin-belirledigi-guclu-mssql-parolasi>
FINMAKS_API_KEY=<finmaks-tarafindan-verilen-gercek-api-anahtari>

# İsteğe bağlı host portları. Port çakışması yoksa değiştirmeniz gerekmez.
MSSQL_PORT=1433
WEB_PORT=5271
API_PORT=5272
