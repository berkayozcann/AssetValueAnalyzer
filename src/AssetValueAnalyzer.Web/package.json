{
  "name": "asset-value-analyzer-web",
  "private": true,
  "scripts": {
    "assets:build": "pnpm run assets:vendor && pnpm run css:build",
    "assets:vendor": "node ./Assets/Scripts/vendor-assets.mjs",
    "css:build": "tailwindcss -i ./Assets/Styles/app.css -o ./wwwroot/css/app.css --minify",
    "css:watch": "pnpm run assets:vendor && tailwindcss -i ./Assets/Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@microsoft/signalr": "10.0.11",
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "pnpm@11.16.0"
}
