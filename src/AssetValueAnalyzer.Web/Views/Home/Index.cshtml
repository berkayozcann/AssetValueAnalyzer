@using AssetValueAnalyzer.Web.Features.Dashboard
@using AssetValueAnalyzer.Web.Features.Shared
@model DashboardPageViewModel

@{
    ViewData["Title"] = "Finansal Etki Analizi";
    ViewData["ActiveNavigation"] = "Home";

    var assetFile = Model.AssetValues;
    var indexFile = Model.ProducerPriceIndices;
    var assetFirstMonth = assetFile?.FirstMonth?.ToString("yyyy-MM");
    var assetLastMonth = assetFile?.LastMonth?.ToString("yyyy-MM");
}

<section class="app-shell pb-12 pt-10 lg:pt-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl">
            <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Finansal Etki Analizi</h1>
            <p class="mt-4 text-base muted-copy sm:text-lg">Varlık ve endeks verilerinizi yükleyin, tarih aralığını seçin ve finansal etkinizi analiz edin.</p>
        </div>

        <partial name="_ExchangeRateCard" model="Model.ExchangeRate" />
    </div>

    @if (Model.HasCompletedReport)
    {
        <section class="mt-7 flex flex-col gap-4 rounded-2xl border border-positive-400/30 bg-positive-400/[0.08] px-5 py-5 sm:flex-row sm:items-center sm:justify-between" aria-label="Tamamlanan rapor">
            <div>
                <p class="font-semibold text-white">Finansal etki analizi raporunuz hazır.</p>
                <p class="mt-1 text-sm text-slate-300">Raporu görüntüleyebilir veya yeni bir rapor oluşturabilirsiniz.</p>
            </div>
            <div class="grid w-full shrink-0 grid-cols-1 gap-3 sm:w-[25rem] sm:grid-cols-2">
                <a class="secondary-button inline-flex h-11 w-full items-center justify-center rounded-lg px-5 text-sm font-medium"
                   asp-controller="Reports" asp-action="Index">Raporu Gör</a>
                <form class="w-full" asp-controller="Reports" asp-action="New" method="post">
                    <button type="submit" class="secondary-button h-11 w-full rounded-lg px-4 text-sm font-medium text-accent-300 hover:text-accent-300">＋ Yeni Rapor</button>
                </form>
            </div>
        </section>
    }

    <section class="glass-panel report-builder-panel mt-9 overflow-hidden rounded-[2rem]"
             data-report-wizard
             data-report-locked="@(Model.HasCompletedReport ? "true" : "false")"
             data-range-validation-url="@Url.Action("ValidateRange", "Reports")"
             data-asset-ready="@(assetFile is not null ? "true" : "false")"
             data-asset-file-name="@(assetFile?.FileName ?? string.Empty)"
             data-asset-first-month="@(assetFirstMonth ?? string.Empty)"
             data-asset-last-month="@(assetLastMonth ?? string.Empty)"
             data-index-ready="@(indexFile is not null ? "true" : "false")"
             data-index-file-name="@(indexFile?.FileName ?? string.Empty)">
        <form class="report-builder-content px-6 py-7 sm:px-10 lg:px-14 lg:py-9"
              asp-controller="Reports"
              asp-action="Create"
              method="post">
            @if (TempData["ReportCreationError"] is string reportCreationError)
            {
                <div class="mb-6 rounded-xl border border-negative-400/35 bg-negative-400/10 px-5 py-4 text-sm text-negative-400"
                     data-report-creation-error
                     role="alert">
                    @reportCreationError
                </div>
            }
            <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-center gap-5">
                    <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-brand-400/20 bg-brand-500/20 text-brand-400 sm:h-20 sm:w-20">
                        <svg class="h-9 w-9" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                            <path d="M6 2.75h8l4 4V21.25H6z"></path>
                            <path d="M14 2.75v4h4M9 16v-3m3 3V9m3 7v-5"></path>
                        </svg>
                    </span>
                    <div>
                        <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Yeni Rapor Oluştur</h2>
                        <p class="mt-1 text-base muted-copy">Üç kısa adımda finansal etkinizi analiz edin.</p>
                    </div>
                </div>

            </div>

            <ol class="mt-10 grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-3" aria-label="Rapor oluşturma adımları">
                <li class="flex items-center gap-3" data-step-marker="1">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full border border-accent-300 bg-accent-300 font-semibold text-canvas-950" data-step-circle>
                        <span data-step-number>1</span>
                    </span>
                    <span class="hidden font-medium text-white sm:block" data-step-label>Veri Dosyaları</span>
                </li>
                <li class="h-px bg-slate-600/70" data-step-connector="1" aria-hidden="true"></li>
                <li class="flex items-center gap-3" data-step-marker="2">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-600 bg-slate-700/70 font-semibold text-slate-200" data-step-circle>
                        <span data-step-number>2</span>
                    </span>
                    <span class="hidden font-medium text-slate-400 sm:block" data-step-label>Tarih Aralığı</span>
                </li>
                <li class="h-px bg-slate-600/70" data-step-connector="2" aria-hidden="true"></li>
                <li class="flex items-center gap-3" data-step-marker="3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-600 bg-slate-700/70 font-semibold text-slate-200" data-step-circle>
                        <span data-step-number>3</span>
                    </span>
                    <span class="hidden font-medium text-slate-400 sm:block" data-step-label>Onay</span>
                </li>
            </ol>

            <div class="wizard-stage mt-8" data-step-panel="1">
                <div class="space-y-4">
                    <article class="field-card rounded-2xl px-5 py-5 sm:px-7" data-file-row="assetFile">
                        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-4">
                                    <h3 class="text-lg font-semibold text-white">Varlık Verisi</h3>
                                    <span class="max-w-full truncate rounded-lg border border-dashed border-slate-600 px-4 py-2 text-sm @(assetFile is null ? "text-slate-400" : "text-white")" data-file-name>@(assetFile?.FileName ?? "Henüz dosya seçilmedi")</span>
                                    <span class="rounded-full border border-positive-400/45 px-3 py-1 text-xs text-positive-400 @(assetFile is null ? "hidden" : string.Empty)" data-file-status>@(assetFile is null ? "Seçildi" : "Doğrulandı")</span>
                                </div>
                                <p class="mt-3 text-sm @(assetFile is null ? "text-slate-400" : "text-positive-400")" data-file-validation aria-live="polite">@(assetFile?.MonthRange ?? string.Empty)</p>
                                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                                    <a href="~/samples/asset-values.xlsx" download class="inline-flex items-center gap-2 text-sm text-brand-400 hover:text-accent-300">
                                        <span aria-hidden="true">↓</span> Örnek XLSX
                                    </a>
                                    <a href="~/samples/asset-values.xml" download class="inline-flex items-center gap-2 text-sm text-brand-400 hover:text-accent-300">
                                        <span aria-hidden="true">↓</span> Örnek XML
                                    </a>
                                </div>
                            </div>
                            <div class="flex flex-wrap items-center gap-5">
                                @if (!Model.HasCompletedReport)
                                {
                                    <label class="secondary-button cursor-pointer rounded-lg px-7 py-3 text-center font-medium text-accent-300 hover:text-accent-300">
                                        Dosya Seç
                                        <input class="sr-only" type="file" accept=".xlsx,.xml" data-file-input="assetFile" />
                                    </label>
                                    <button type="button"
                                            class="inline-flex items-center gap-2 rounded-lg border border-negative-400/35 bg-negative-400/[0.07] px-4 py-3 text-sm font-medium text-negative-400 transition hover:border-negative-400/60 hover:bg-negative-400/[0.12] @(assetFile is null ? "hidden" : string.Empty)"
                                            style="@(assetFile is null ? "display: none;" : null)"
                                            data-file-clear
                                            data-file-kind="assetFile"
                                            data-file-clear-url="@Url.Action("ClearAssets", "Imports")">
                                        <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5m4-5v5"></path></svg>
                                        Dosyayı Temizle
                                    </button>
                                }
                                else
                                {
                                    <span class="rounded-lg border border-line-700 px-4 py-2 text-sm text-slate-400">Raporda kullanıldı</span>
                                }
                                <span class="text-sm text-slate-400">XLSX veya XML</span>
                            </div>
                        </div>
                    </article>

                    <article class="field-card rounded-2xl px-5 py-5 sm:px-7" data-file-row="indexFile">
                        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-4">
                                    <h3 class="text-lg font-semibold text-white">Endeks Verisi</h3>
                                    <span class="max-w-full truncate rounded-lg border border-dashed border-slate-600 px-4 py-2 text-sm @(indexFile is null ? "text-slate-400" : "text-white")" data-file-name>@(indexFile?.FileName ?? "Henüz dosya seçilmedi")</span>
                                    <span class="rounded-full border border-positive-400/45 px-3 py-1 text-xs text-positive-400 @(indexFile is null ? "hidden" : string.Empty)" data-file-status>@(indexFile is null ? "Seçildi" : "Doğrulandı")</span>
                                </div>
                                <p class="mt-3 text-sm @(indexFile is null ? "text-slate-400" : "text-positive-400")" data-file-validation aria-live="polite">@(indexFile?.MonthRange ?? string.Empty)</p>
                                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                                    <a href="~/samples/producer-price-indices.xlsx" download class="inline-flex items-center gap-2 text-sm text-brand-400 hover:text-accent-300">
                                        <span aria-hidden="true">↓</span> Örnek XLSX
                                    </a>
                                    <a href="~/samples/producer-price-indices.xml" download class="inline-flex items-center gap-2 text-sm text-brand-400 hover:text-accent-300">
                                        <span aria-hidden="true">↓</span> Örnek XML
                                    </a>
                                </div>
                            </div>
                            <div class="flex flex-wrap items-center gap-5">
                                @if (!Model.HasCompletedReport)
                                {
                                    <label class="secondary-button cursor-pointer rounded-lg px-7 py-3 text-center font-medium text-accent-300 hover:text-accent-300">
                                        Dosya Seç
                                        <input class="sr-only" type="file" accept=".xlsx,.xml" data-file-input="indexFile" />
                                    </label>
                                    <button type="button"
                                            class="inline-flex items-center gap-2 rounded-lg border border-negative-400/35 bg-negative-400/[0.07] px-4 py-3 text-sm font-medium text-negative-400 transition hover:border-negative-400/60 hover:bg-negative-400/[0.12] @(indexFile is null ? "hidden" : string.Empty)"
                                            style="@(indexFile is null ? "display: none;" : null)"
                                            data-file-clear
                                            data-file-kind="indexFile"
                                            data-file-clear-url="@Url.Action("ClearProducerPriceIndices", "Imports")">
                                        <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5m4-5v5"></path></svg>
                                        Dosyayı Temizle
                                    </button>
                                }
                                else
                                {
                                    <span class="rounded-lg border border-line-700 px-4 py-2 text-sm text-slate-400">Raporda kullanıldı</span>
                                }
                                <span class="text-sm text-slate-400">XLSX veya XML</span>
                            </div>
                        </div>
                    </article>
                </div>

                <div class="wizard-action-row">
                    <p class="flex items-center gap-3 text-sm text-slate-400">
                        <svg class="h-5 w-5 shrink-0 text-slate-300" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="5" y="10" width="14" height="11" rx="2"></rect>
                            <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path>
                        </svg>
                        Varlık ve Endeks dosyaları doğrulandıktan sonra tarih adımına geçebilirsiniz.
                    </p>
                    <button type="button" class="primary-button wizard-action-button" data-step-one-continue data-go-step="2" disabled="@(assetFile is null || indexFile is null)">Devam Et</button>
                </div>
            </div>

            <div class="wizard-stage mt-8" data-step-panel="2" hidden>
                <div class="flex flex-col gap-4 rounded-2xl border border-line-700 bg-canvas-950/55 px-5 py-5 lg:flex-row lg:items-center lg:justify-between">
                    <p class="truncate text-sm text-slate-300"><span class="mr-2 text-positive-400">✓</span><strong class="text-white">Varlık:</strong> <span data-summary-asset>@(assetFile?.FileName ?? "Seçilen dosya")</span></p>
                    <span class="hidden h-8 w-px bg-line-700 lg:block" aria-hidden="true"></span>
                    <p class="truncate text-sm text-slate-300"><span class="mr-2 text-positive-400">✓</span><strong class="text-white">Endeks:</strong> <span data-summary-index>@(indexFile?.FileName ?? "Seçilen dosya")</span></p>
                </div>

                <div class="mt-7">
                    <h3 class="inline-flex items-center gap-2 text-xl font-semibold text-white">
                        Rapor Tarih Aralığı
                        @await Html.PartialAsync(
                            "_InfoTooltip",
                            new InfoTooltipViewModel(
                                "Rapor Tarih Aralığı",
                                "Başlangıç ve bitiş ayı seçilmezse: Varlık dosyasındaki ilk ve son ay kullanılır.\n\nYalnızca başlangıç ayı seçilirse: Seçilen aydan dosyanın son ayına kadar hesaplanır.\n\nYalnızca bitiş ayı seçilirse: Dosyanın ilk ayından seçilen aya kadar hesaplanır.\n\nFinansal değişim hesabı için en az iki farklı ay gerekir."))
                    </h3>
                    <div class="mt-5 grid gap-5 md:grid-cols-2">
                        <div class="relative" data-month-picker data-min-month="@(assetFirstMonth ?? "2021-12")" data-max-month="@(assetLastMonth ?? "2023-08")" data-completed-months-only="true">
                            <span class="mb-2 block text-sm text-slate-400">Başlangıç Ayı</span>
                            <button type="button"
                                    class="field-card flex w-full items-center justify-between rounded-xl px-5 py-4 text-left"
                                    aria-expanded="false"
                                    aria-controls="start-month-picker"
                                    data-month-picker-toggle>
                                <span class="text-lg font-medium text-slate-400" data-month-picker-display>Seçilmedi</span>
                                <svg class="h-6 w-6 text-slate-300" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                    <path d="M8 3v4M16 3v4M3 10h18"></path>
                                </svg>
                            </button>
                            <input id="startMonth" name="StartMonth" type="hidden" value="" data-month-picker-input />
                            <section id="start-month-picker"
                                     class="month-picker-panel fixed z-50 w-72 rounded-xl p-4"
                                     data-month-picker-panel
                                     hidden>
                                <div class="flex items-center justify-between">
                                    <button type="button" class="secondary-button rounded-lg px-3 py-2" aria-label="Önceki yıl" data-month-year-previous>←</button>
                                    <strong class="text-white" data-month-year></strong>
                                    <button type="button" class="secondary-button rounded-lg px-3 py-2" aria-label="Sonraki yıl" data-month-year-next>→</button>
                                </div>
                                <div class="mt-3 grid grid-cols-3 gap-2" data-month-grid></div>
                                <button type="button" class="mt-3 text-sm text-accent-300" data-month-picker-clear>Seçimi temizle</button>
                            </section>
                        </div>
                        <div class="relative" data-month-picker data-min-month="@(assetFirstMonth ?? "2021-12")" data-max-month="@(assetLastMonth ?? "2023-08")" data-completed-months-only="true">
                            <span class="mb-2 block text-sm text-slate-400">Bitiş Ayı</span>
                            <button type="button"
                                    class="field-card flex w-full items-center justify-between rounded-xl px-5 py-4 text-left"
                                    aria-expanded="false"
                                    aria-controls="end-month-picker"
                                    data-month-picker-toggle>
                                <span class="text-lg font-medium text-slate-400" data-month-picker-display>Seçilmedi</span>
                                <svg class="h-6 w-6 text-slate-300" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                    <path d="M8 3v4M16 3v4M3 10h18"></path>
                                </svg>
                            </button>
                            <input id="endMonth" name="EndMonth" type="hidden" value="" data-month-picker-input />
                            <section id="end-month-picker"
                                     class="month-picker-panel fixed z-50 w-72 rounded-xl p-4"
                                     data-month-picker-panel
                                     hidden>
                                <div class="flex items-center justify-between">
                                    <button type="button" class="secondary-button rounded-lg px-3 py-2" aria-label="Önceki yıl" data-month-year-previous>←</button>
                                    <strong class="text-white" data-month-year></strong>
                                    <button type="button" class="secondary-button rounded-lg px-3 py-2" aria-label="Sonraki yıl" data-month-year-next>→</button>
                                </div>
                                <div class="mt-3 grid grid-cols-3 gap-2" data-month-grid></div>
                                <button type="button" class="mt-3 text-sm text-accent-300" data-month-picker-clear>Seçimi temizle</button>
                            </section>
                        </div>
                    </div>
                    <p class="mt-3 text-sm text-negative-400" data-month-range-error aria-live="polite" hidden>Başlangıç ayı bitiş ayından sonra olamaz.</p>
                </div>

                <div class="wizard-action-row">
                    <button type="button" class="secondary-button wizard-action-button" data-go-step="1">Geri</button>
                    <button type="button" class="primary-button wizard-action-button" data-step-two-continue data-go-step="3">Devam Et</button>
                </div>
            </div>

            <div class="wizard-stage mt-8" data-step-panel="3" hidden>
                <div class="grid auto-rows-fr gap-5 lg:grid-cols-2">
                    <section class="surface-card h-full min-h-48 rounded-2xl px-6 py-6">
                        <h3 class="text-xl font-semibold text-white">Veri Dosyaları</h3>
                        <dl class="mt-5 space-y-4 text-sm">
                            <div class="flex items-center justify-between gap-4 border-b border-line-700 pb-4">
                                <dt class="font-medium text-white"><span class="mr-2 text-positive-400">✓</span>Varlık Verisi</dt>
                                <dd class="max-w-64 truncate text-slate-300" data-summary-asset>—</dd>
                            </div>
                            <div class="flex items-center justify-between gap-4">
                                <dt class="font-medium text-white"><span class="mr-2 text-positive-400">✓</span>Endeks Verisi</dt>
                                <dd class="max-w-64 truncate text-slate-300" data-summary-index>—</dd>
                            </div>
                        </dl>
                    </section>
                    <section class="surface-card h-full min-h-48 rounded-2xl px-6 py-6">
                        <h3 class="text-xl font-semibold text-white">Hesaplama Kapsamı</h3>
                        <dl class="mt-5 space-y-4 text-sm">
                            <div class="flex items-center justify-between gap-4 border-b border-line-700 pb-4">
                                <dt class="text-slate-400">Tarih Aralığı</dt>
                                <dd class="text-right font-medium text-white" data-summary-period>Dosyadaki ilk ve son ay</dd>
                            </div>
                            <div class="hidden justify-end" data-summary-automatic-note-row>
                                <p class="text-right text-xs text-slate-400" data-summary-automatic-note></p>
                            </div>
                            <div class="flex items-center justify-between gap-4">
                                <dt class="text-slate-400">Dahil Edilen Ay</dt>
                                <dd class="text-right font-medium text-white" data-summary-duration>Otomatik</dd>
                            </div>
                        </dl>
                    </section>
                </div>

                <p class="mt-5 rounded-xl border border-brand-400/15 bg-brand-500/10 px-5 py-4 text-sm text-slate-300">
                    Rapor; aylık varlık tutarları, ÜFE endeksleri ve ay sonu iş günü USD/TRY kurları birlikte değerlendirilerek hazırlanacaktır.
                </p>

                <div class="wizard-action-row">
                    <button type="button" class="secondary-button wizard-action-button" data-go-step="2">Geri</button>
                    <button type="submit"
                            class="primary-button wizard-action-button">
                        Raporu Oluştur
                    </button>
                </div>
            </div>
        </form>
    </section>
</section>
