@using AssetValueAnalyzer.Web.Features.Shared
@model ExchangeRateCardViewModel

@{
    var cardState = Model switch
    {
        { HasRate: false } => "empty",
        { IsDemo: true } => "demo",
        { IsAwaitingCurrentDayRate: true } => "waiting",
        _ => "available"
    };

    var trendColor = Model.Trend switch
    {
        ExchangeRateTrend.Increased => "text-positive-300",
        ExchangeRateTrend.Decreased => "text-negative-300",
        _ => "text-rate-muted"
    };

    var trendSymbol = Model.Trend switch
    {
        ExchangeRateTrend.Increased => "▲",
        ExchangeRateTrend.Decreased => "▼",
        _ => "—"
    };
}

<aside class="surface-card exchange-rate-card min-w-64 rounded-xl px-5 py-4 lg:mt-20"
       data-exchange-rate-card
       data-rate-state="@cardState"
       data-refresh-url="@Url.Action("Card", "ExchangeRates")"
       aria-label="USD/TRY kur özeti"
       aria-live="polite"
       aria-atomic="true">
    <div class="exchange-rate-card__content">
        <div class="flex items-start justify-between gap-4">
            <div class="flex min-w-0 items-center gap-2">
                <p class="font-display text-sm font-semibold tracking-[0.04em] text-petrol-200">@Model.Label</p>

                @if (!Model.HasRate)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-petrol-400/55 bg-petrol-400/10 px-2 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.08em] text-petrol-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-petrol-400" aria-hidden="true"></span>
                        Veri yok
                    </span>
                }
                else if (Model.IsDemo)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-petrol-400/45 bg-petrol-400/10 px-2 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.08em] text-petrol-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-petrol-400" aria-hidden="true"></span>
                        Demo
                    </span>
                }
                else if (Model.IsAwaitingCurrentDayRate)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-rate-muted/55 bg-white/5 px-2 py-0.5 text-[0.625rem] font-semibold uppercase tracking-[0.06em] text-rate-muted">
                        <span class="h-1.5 w-1.5 rounded-full bg-rate-muted" aria-hidden="true"></span>
                        Bugünün kuru bekleniyor
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center" aria-label="Kur verisi düzenli olarak kontrol ediliyor.">
                        <span class="exchange-rate-card__status-dot h-1.5 w-1.5 rounded-full bg-petrol-500" aria-hidden="true"></span>
                    </span>
                }
            </div>

            <svg class="exchange-rate-card__brand-mark h-5 w-8 shrink-0 text-petrol-400"
                 viewBox="0 0 44 28"
                 fill="none"
                 aria-hidden="true"
                 focusable="false">
                <path d="M3 4 15 24 29 4 41 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
            </svg>
        </div>

        <div class="mt-1 flex items-center gap-3">
            <p class="font-display text-2xl font-semibold tracking-tight tabular-nums text-on-petrol">@Model.FormattedRate</p>

            @if (Model.HasRate)
            {
                <span class="@trendColor text-base leading-none" role="img" aria-label="@Model.TrendText">@trendSymbol</span>
            }
        </div>

        @if (Model.HasRate)
        {
            <p class="mt-2 text-xs text-rate-muted">@Model.RateDateText</p>
        }

        <p class="mt-1 flex items-center gap-2 text-xs text-rate-muted">
            <svg class="h-4 w-4 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
            </svg>
            @Model.LastSyncText
        </p>
    </div>
</aside>
