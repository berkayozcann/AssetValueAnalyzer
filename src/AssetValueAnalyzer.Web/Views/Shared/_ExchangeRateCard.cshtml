@using AssetValueAnalyzer.Web.Features.Shared
@model ExchangeRateCardViewModel

@{
    var trendColor = Model.Trend switch
    {
        ExchangeRateTrend.Increased => "text-positive-400",
        ExchangeRateTrend.Decreased => "text-negative-400",
        _ => "text-slate-400"
    };

    var trendSymbol = Model.Trend switch
    {
        ExchangeRateTrend.Increased => "▲",
        ExchangeRateTrend.Decreased => "▼",
        _ => "—"
    };
}

<aside class="surface-card min-w-64 rounded-xl px-5 py-4"
       data-exchange-rate-card
       data-refresh-url="@Url.Action("Card", "ExchangeRates")"
       aria-label="@Model.Label"
       aria-live="polite"
       aria-atomic="true">
    <div>
        <div class="flex items-center gap-2">
            <p class="text-sm text-slate-300">@Model.Label</p>
            @if (Model.IsDemo)
            {
                <span class="rounded-full border border-brand-400/45 bg-brand-500/10 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wider text-brand-400">Demo</span>
            }
        </div>
        <div class="mt-1 flex items-center gap-3">
            <p class="text-2xl font-semibold tracking-tight text-white">@Model.FormattedRate</p>
            <span class="@trendColor text-base leading-none" role="img" aria-label="Kur yönü: @Model.TrendText">@trendSymbol</span>
        </div>
    </div>
    <p class="mt-3 flex items-center gap-2 text-xs text-slate-400">
        <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
        </svg>
        @Model.LastSyncText
    </p>
</aside>
