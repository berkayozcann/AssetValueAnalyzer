@using AssetValueAnalyzer.Web.Features.Shared
@model InfoTooltipViewModel

@{
    var tooltipId = $"info-tooltip-{Guid.NewGuid():N}";
}

<span class="relative inline-flex align-middle" data-info-tooltip>
    <button type="button"
            class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-brand-400/45 text-[0.6rem] font-semibold text-brand-400 transition hover:border-brand-400 hover:text-brand-500"
            aria-label="@Model.Label açıklaması"
            aria-describedby="@tooltipId">
        i
    </button>
    <span id="@tooltipId"
          role="tooltip"
          class="info-tooltip-panel pointer-events-none fixed z-[100] w-72 rounded-lg border border-petrol-600 bg-petrol-900 px-3 py-2 text-left text-xs font-normal leading-relaxed text-rate-muted"
          hidden
          data-info-tooltip-content>
        <strong class="mb-1 block text-on-petrol">@Model.Label</strong>
        <span class="block whitespace-pre-line">@Model.Description</span>
    </span>
</span>
