@using AssetValueAnalyzer.Web.Features.Reports
@using AssetValueAnalyzer.Web.Features.Shared
@model ReportPageViewModel

@{
    ViewData["Title"] = "Finansal Etki Raporu";
    ViewData["ActiveNavigation"] = "Reports";
    var resetReportWizard = TempData["ResetReportWizard"] is true;

    static string ValueTone(string value) => value switch
    {
        var text when text.StartsWith('+') => "text-positive-400",
        var text when text.StartsWith('-') => "text-negative-400",
        _ => "text-slate-300"
    };

    string SortAriaValue(ReportSortColumn column) =>
        Model.SortColumn != column
            ? "none"
            : Model.SortDirection == ReportSortDirection.Ascending
                ? "ascending"
                : "descending";

    ReportSortLinkViewModel SortLink(ReportSortColumn column, string label)
    {
        var isActive = Model.SortColumn == column;
        var sortKey = ReportTableSort.ToQueryValue(column);
        var url = !isActive
            ? Url.Action("Index", "Reports", new { sort = sortKey, direction = "asc" })
            : Model.SortDirection == ReportSortDirection.Ascending
                ? Url.Action("Index", "Reports", new { sort = sortKey, direction = "desc" })
                : Url.Action("Index", "Reports");

        return new ReportSortLinkViewModel(
            label,
            url ?? "/reports",
            sortKey,
            isActive,
            Model.SortDirection);
    }

    const int pageSize = 10;
    var pageCount = Math.Max(1, (int)Math.Ceiling(Model.Rows.Count / (double)pageSize));
    var requestedPage = int.TryParse(Context.Request.Query["page"], out var parsedPage)
        ? parsedPage
        : 1;
    var currentPage = Math.Clamp(requestedPage, 1, pageCount);
    var firstVisibleRowIndex = (currentPage - 1) * pageSize;
    var lastVisibleRowIndex = Math.Min(firstVisibleRowIndex + pageSize, Model.Rows.Count);
}

<section class="app-shell pb-10 pt-10 lg:pt-12"
         data-reset-report-wizard="@(resetReportWizard ? "true" : "false")">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl" data-page-intro>
            <div class="flex flex-wrap items-center gap-4">
                <h1 class="text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl">Finansal Etki Raporu</h1>
            </div>
            <span class="mt-4 block h-1 w-16 rounded-full bg-brand-400" aria-hidden="true"></span>
            <p class="mt-5 max-w-3xl text-base leading-relaxed muted-copy sm:text-lg">Seçilen rapor döneminde varlığınızın nominal değişimini, USD/TRY kuru karşısındaki performansını ve Yİ-ÜFE’ye göre reel değişimini karşılaştırın.</p>
            <p class="mt-3 text-sm text-slate-400">
                Rapor Dönemi · <strong class="font-medium text-slate-200" data-report-period>@Model.Period</strong>
            </p>
        </div>

        <partial name="_ExchangeRateCard" model="Model.ExchangeRate" />
    </div>

    <div class="mt-5 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-end" data-page-body-motion>
        <a class="secondary-button inline-flex h-10 w-full items-center justify-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-semibold sm:mr-auto sm:w-44"
           asp-controller="Reports"
           asp-action="Download"
           data-report-download>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12"></path>
                <path d="m7 10 5 5 5-5"></path>
                <path d="M5 21h14"></path>
            </svg>
            Raporu indir
        </a>
        <partial name="_ReportDateRangePanel" model="Model" />
        <form class="w-full sm:w-44" asp-controller="Reports" asp-action="New" method="post">
            <button type="submit"
                    class="primary-button inline-flex h-10 w-full items-center justify-center gap-2 whitespace-nowrap rounded-lg px-4 text-sm font-semibold"
                    data-new-analysis-action>
                <span class="text-base leading-none" aria-hidden="true">＋</span>
                Yeni Analiz
            </button>
        </form>
    </div>

    <section class="mt-7 grid auto-rows-fr gap-4 sm:grid-cols-2 xl:grid-cols-4"
             data-page-body-motion
             aria-label="Finansal etki raporu özeti">
        @foreach (var kpi in Model.Kpis)
        {
            var valueClass = kpi.Tone switch
            {
                ReportKpiTone.Positive => "text-positive-400",
                ReportKpiTone.Negative => "text-negative-400",
                _ => "text-ink-900"
            };
            <article class="surface-card h-full min-h-40 rounded-xl px-5 py-5">
                <div class="flex h-full items-start gap-4">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-icon-line bg-icon-surface text-brand-400" aria-hidden="true">
                        @switch (kpi.Icon)
                        {
                            case ReportKpiIcon.AssetAmount:
                                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18a2 2 0 0 1 2 2v1H7a3 3 0 0 0 0 6h13v3a2 2 0 0 1-2 2H6.5A2.5 2.5 0 0 1 4 16.5z"></path>
                                    <path d="M20 8v6h-3a3 3 0 0 1 0-6z"></path>
                                    <circle cx="17" cy="11" r=".75" fill="currentColor" stroke="none"></circle>
                                </svg>
                                break;
                            case ReportKpiIcon.NominalChange:
                                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 5v14h16"></path>
                                    <path d="m7 15 4-4 3 2 5-6"></path>
                                    <path d="M15.5 7H19v3.5"></path>
                                </svg>
                                break;
                            case ReportKpiIcon.DollarizedChange:
                                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6.25 8A7 7 0 0 1 18 7M18 4v3h-3M17.75 16A7 7 0 0 1 6 17M6 20v-3h3"></path>
                                    <path d="M12 8.5v7M14 10c-.45-.75-1.15-1.1-2.05-1.1-1.1 0-1.8.55-1.8 1.35 0 2.15 3.85 1.05 3.85 3.35 0 .9-.8 1.5-2 1.5-.95 0-1.7-.35-2.15-1.05"></path>
                                </svg>
                                break;
                            case ReportKpiIcon.InflationAdjustedChange:
                                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 3 19 6v5c0 4.5-2.75 7.9-7 10-4.25-2.1-7-5.5-7-10V6z"></path>
                                    <path d="M9 15v-3M12 15V9M15 15v-5"></path>
                                </svg>
                                break;
                        }
                    </span>
                    <div class="min-w-0">
                        <p class="text-sm text-slate-200">@kpi.Label</p>
                        <p class="font-display @valueClass mt-2 text-2xl font-semibold tracking-tight tabular-nums">@kpi.Value</p>
                        <p class="mt-2 text-sm text-slate-400">@kpi.Description</p>
                    </div>
                </div>
            </article>
        }
    </section>

    <section class="mt-5 overflow-hidden rounded-xl border border-line-700 bg-surface-900"
             data-page-body-motion
             aria-labelledby="monthly-details-heading">
        <div class="flex flex-wrap items-center gap-4 border-b border-line-700 px-5 py-3">
            <h2 id="monthly-details-heading" class="text-xl font-semibold text-ink-900">Aylık Finansal Detaylar</h2>
            <p class="text-sm text-slate-400">@Model.Rows.Count ay</p>
        </div>

        <div class="data-table-scroll overflow-x-auto">
            <table class="min-w-[1900px] border-collapse text-sm tabular-nums">
                <thead class="sticky top-0 z-20 bg-surface-900 text-left text-ink-700">
                    <tr>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.Month)" class="sticky left-0 z-30 w-40 min-w-40 border-b border-r border-line-700 bg-surface-900 px-5 py-3 text-left font-medium">
                            <partial name="_ReportSortLink" model='SortLink(ReportSortColumn.Month, "Tarih")' />
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.AssetValue)" class="w-48 min-w-48 border-b border-r border-line-700 bg-surface-900 px-5 py-3 text-right font-medium md:sticky md:left-40 md:z-30">
                            <partial name="_ReportSortLink" model='SortLink(ReportSortColumn.AssetValue, "Varlık Tutarı")' />
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.MonthlyAssetIncreaseRate)" class="min-w-48 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.MonthlyAssetIncreaseRate, "Önceki Aya Göre Varlık Artışı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Önceki Aya Göre Varlık Artışı", "Varlık tutarının bir önceki aya göre yüzde değişimidir."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.AssetChangeRate)" class="min-w-48 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.AssetChangeRate, "Varlık Değişim Oranı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Varlık Değişim Oranı", "İlgili aydan rapor ayına kadar nominal varlığın yüzde değişimidir."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.UsdRate)" class="min-w-36 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.UsdRate, "USD Kuru")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("USD Kuru", "İlgili ayın son iş günündeki USD/TRY kurudur."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.DollarizedAmount)" class="min-w-52 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.DollarizedAmount, "Dolarizasyon Varlık Tutarı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Dolarizasyon Varlık Tutarı", "Varlığın kur değişimiyle rapor ayına taşınmış tutarıdır."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.MonthlyDollarizedIncreaseRate)" class="min-w-60 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.MonthlyDollarizedIncreaseRate, "Dolarizasyon Önceki Aya Göre Varlık Artışı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Dolarizasyon Aylık Artışı", "Dolarizasyon tutarının bir önceki aya göre yüzde değişimidir."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.DollarizedChangeRate)" class="min-w-60 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.DollarizedChangeRate, "Dolarizasyon Varlık Değişim Oranı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Dolarizasyon Değişim Oranı", "İlgili aydan rapor ayına kadar dolarizasyon tutarının yüzde değişimidir."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.DollarizationEffect)" class="min-w-44 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.DollarizationEffect, "Dolarizasyon Etkisi (%)")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Dolarizasyon Etkisi", "Nominal tutarın kur etkisinden sonraki yüzde farkıdır."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.ProducerPriceIndex)" class="min-w-40 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.ProducerPriceIndex, "Yİ-ÜFE Endeksi")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Yİ-ÜFE Endeksi", "İlgili aya ait yurt içi üretici fiyat endeksi puanıdır."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.InflationAdjustedAmount)" class="min-w-56 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.InflationAdjustedAmount, "Enflasyon Varlık Tutarı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Enflasyon Varlık Tutarı", "Varlığın Yİ-ÜFE değişimiyle rapor ayına taşınmış tutarıdır."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.MonthlyInflationAdjustedIncreaseRate)" class="min-w-64 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.MonthlyInflationAdjustedIncreaseRate, "Enflasyon Önceki Aya Göre Varlık Artışı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Enflasyon Aylık Artışı", "Enflasyon tutarının bir önceki aya göre yüzde değişimidir."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.InflationAdjustedChangeRate)" class="min-w-64 border-b border-r border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.InflationAdjustedChangeRate, "Enflasyon Varlık Değişim Oranı")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Enflasyon Değişim Oranı", "İlgili aydan rapor ayına kadar enflasyon tutarının yüzde değişimidir."))</span>
                        </th>
                        <th scope="col" aria-sort="@SortAriaValue(ReportSortColumn.InflationEffect)" class="min-w-44 border-b border-line-700 px-5 py-3 text-right font-medium">
                            <span class="inline-flex items-center gap-2"><partial name="_ReportSortLink" model='SortLink(ReportSortColumn.InflationEffect, "Enflasyon Etkisi (%)")' /> @await Html.PartialAsync("_InfoTooltip", new InfoTooltipViewModel("Enflasyon Etkisi", "Nominal tutarın Yİ-ÜFE etkisinden sonraki yüzde farkıdır."))</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line-700/85 text-slate-200">
                    @for (var rowIndex = 0; rowIndex < Model.Rows.Count; rowIndex++)
                    {
                        var row = Model.Rows[rowIndex];
                        <tr class="transition hover:bg-brand-500/5"
                            data-report-row
                            hidden="@(rowIndex < firstVisibleRowIndex || rowIndex >= lastVisibleRowIndex ? "hidden" : null)">
                            <th scope="row" class="sticky left-0 z-10 w-40 min-w-40 border-r border-line-700 bg-canvas-900 px-5 py-2.5 text-left font-medium text-ink-900">@row.Month</th>
                            <td class="w-48 min-w-48 border-r border-line-700 bg-surface-900 px-5 py-2.5 text-right font-medium text-ink-900 md:sticky md:left-40 md:z-10">@row.AssetValue</td>
                            <td class="@ValueTone(row.MonthlyAssetIncreaseRate) border-r border-line-700 px-5 py-2.5 text-right">@row.MonthlyAssetIncreaseRate</td>
                            <td class="@ValueTone(row.AssetChangeRate) border-r border-line-700 px-5 py-2.5 text-right">@row.AssetChangeRate</td>
                            <td class="border-r border-line-700 px-5 py-2.5 text-right">@row.UsdRate</td>
                            <td class="border-r border-line-700 px-5 py-2.5 text-right">@row.DollarizedAmount</td>
                            <td class="@ValueTone(row.MonthlyDollarizedIncreaseRate) border-r border-line-700 px-5 py-2.5 text-right">@row.MonthlyDollarizedIncreaseRate</td>
                            <td class="@ValueTone(row.DollarizedChangeRate) border-r border-line-700 px-5 py-2.5 text-right">@row.DollarizedChangeRate</td>
                            <td class="@ValueTone(row.DollarizationEffect) border-r border-line-700 px-5 py-2.5 text-right">@row.DollarizationEffect</td>
                            <td class="border-r border-line-700 px-5 py-2.5 text-right">@row.ProducerPriceIndex</td>
                            <td class="border-r border-line-700 px-5 py-2.5 text-right">@row.InflationAdjustedAmount</td>
                            <td class="@ValueTone(row.MonthlyInflationAdjustedIncreaseRate) border-r border-line-700 px-5 py-2.5 text-right">@row.MonthlyInflationAdjustedIncreaseRate</td>
                            <td class="@ValueTone(row.InflationAdjustedChangeRate) border-r border-line-700 px-5 py-2.5 text-right">@row.InflationAdjustedChangeRate</td>
                            <td class="@ValueTone(row.InflationEffect) px-5 py-2.5 text-right">@row.InflationEffect</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <footer class="flex flex-col gap-3 border-t border-line-700 px-5 py-3 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between"
                data-report-pagination
                data-page-size="@pageSize"
                data-current-page="@currentPage">
            <p data-pagination-summary>@(firstVisibleRowIndex + 1)–@lastVisibleRowIndex / @Model.Rows.Count ay</p>
            <nav class="flex items-center gap-2" aria-label="Aylık finansal detay sayfaları">
                <button type="button"
                        class="secondary-button rounded-lg px-3 py-2 disabled:cursor-not-allowed disabled:opacity-35"
                        aria-label="Önceki sayfa"
                        data-page-previous
                        disabled="@(currentPage == 1 ? "disabled" : null)">←</button>
                @for (var pageNumber = 1; pageNumber <= pageCount; pageNumber++)
                {
                    <button type="button"
                            class="secondary-button min-w-10 rounded-lg px-3 py-2 @(pageNumber == currentPage ? "border-brand-400 bg-brand-500 text-paper-100" : string.Empty)"
                            aria-current="@(pageNumber == currentPage ? "page" : "false")"
                            data-page-number="@pageNumber">@pageNumber</button>
                }
                <button type="button"
                        class="secondary-button rounded-lg px-3 py-2 disabled:cursor-not-allowed disabled:opacity-35"
                        aria-label="Sonraki sayfa"
                        data-page-next
                        disabled="@(currentPage == pageCount ? "disabled" : null)">→</button>
            </nav>
        </footer>
    </section>

</section>
