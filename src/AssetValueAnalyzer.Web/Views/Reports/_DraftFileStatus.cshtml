@using AssetValueAnalyzer.Web.Features.Reports
@model DraftFileStatusViewModel

<article class="surface-card flex h-full min-h-36 items-center rounded-2xl px-6 py-6">
    <div class="flex w-full items-center justify-between gap-4">
        <div class="min-w-0">
            <h3 class="font-semibold text-white">@Model.Label</h3>
            @if (Model.File is not null)
            {
                <p class="mt-2 truncate text-sm text-slate-300">@Model.File.FileName</p>
                @if (Model.File.MonthRange is not null)
                {
                    <p class="mt-1 text-xs text-slate-400">@Model.File.MonthRange</p>
                }
            }
            else
            {
                <p class="mt-2 text-sm text-slate-400">Henüz yüklenmedi</p>
            }
        </div>

        @if (Model.File is not null)
        {
            <span class="shrink-0 rounded-full border border-positive-400/45 px-3 py-1 text-xs text-positive-400">Hazır</span>
        }
        else
        {
            <span class="shrink-0 rounded-full border border-slate-600 px-3 py-1 text-xs text-slate-400">Eksik</span>
        }
    </div>
</article>
