@using AssetValueAnalyzer.Web.Features.Reports
@model DraftFileStatusViewModel

<article class="grid gap-4 px-5 py-5 sm:px-6 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1.35fr)_minmax(0,1fr)_8.5rem] md:items-center lg:px-7">
    <div class="flex min-w-0 items-center gap-4">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-icon-line bg-icon-surface text-brand-400" aria-hidden="true">
            @if (Model.Kind == DraftDataFileKind.AssetValues)
            {
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <ellipse cx="12" cy="5" rx="7" ry="3"></ellipse>
                    <path d="M5 5v7c0 1.66 3.13 3 7 3s7-1.34 7-3V5M5 12v7c0 1.66 3.13 3 7 3s7-1.34 7-3v-7"></path>
                </svg>
            }
            else
            {
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20V10m5 10V4m5 16v-7m5 7V7M3 20h18"></path>
                </svg>
            }
        </span>
        <h3 class="min-w-0 font-semibold text-ink-900">@Model.Label</h3>
    </div>

    <p class="min-w-0 truncate text-sm @(Model.File is null ? "text-slate-400" : "text-slate-200")">
        @(Model.File?.FileName ?? "Henüz yüklenmedi")
    </p>

    <p class="min-w-0 truncate text-sm text-slate-400">@(Model.File?.MonthRange ?? "—")</p>

    @if (Model.File is not null)
    {
        <span class="inline-flex items-center gap-2 whitespace-nowrap text-sm font-medium text-positive-400 md:w-[8.5rem]">
            <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m8 12 2.5 2.5L16 9"></path>
            </svg>
            Doğrulandı
        </span>
    }
    else
    {
        <span class="inline-flex items-center gap-2 whitespace-nowrap text-sm font-medium text-negative-400 md:w-[8.5rem]">
            <svg class="h-6 w-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7.5v6M12 17h.01"></path>
            </svg>
            Eksik
        </span>
    }
</article>
