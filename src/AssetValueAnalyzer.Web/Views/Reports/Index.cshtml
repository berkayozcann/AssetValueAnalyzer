@using AssetValueAnalyzer.Web.Features.Reports
@model ReportWorkspacePageViewModel

@{
    ViewData["Title"] = "Finansal Etki Raporu";
    ViewData["ActiveNavigation"] = "Reports";
    var readyFileProgressOffset = 100 - Model.ReadyFileProgressPercent;
}

<section class="app-shell flex min-h-[calc(100vh-5rem)] flex-col pb-8 pt-10 lg:pt-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl">
            <h1 class="text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl">Finansal Etki Raporu</h1>
            <span class="mt-4 block h-1 w-16 rounded-full bg-brand-400" aria-hidden="true"></span>
            <p class="mt-5 max-w-3xl text-base leading-relaxed muted-copy sm:text-lg">Veri dosyalarınızın durumunu takip edin; finansal etki raporunuz hazır olduğunda nominal değişimi, dolarizasyon etkisini ve enflasyon etkisini bu sayfada inceleyin.</p>
        </div>

        <partial name="_ExchangeRateCard" model="Model.ExchangeRate" />
    </div>

    @if (Model.Status == ReportWorkspaceStatus.Empty)
    {
        <section class="glass-panel mt-9 flex min-h-[27rem] flex-col justify-center overflow-hidden rounded-[2rem] px-6 py-12 text-center sm:px-10" aria-labelledby="empty-report-heading">
            <span class="glass-panel-ornament" aria-hidden="true"></span>
            <div class="mx-auto flex w-full max-w-4xl flex-col items-center">
                <span class="text-brand-400" aria-hidden="true">
                    <svg class="h-20 w-20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2.75h8l4 4V21.25H6z"></path>
                        <path d="M14 2.75v4h4M9 16v-3m3 3V9m3 7v-5"></path>
                    </svg>
                </span>
                <h2 id="empty-report-heading" class="mt-7 text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">Henüz rapor oluşturulmadı</h2>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">Finansal etki raporunuzu oluşturmak için Ana Sayfa’dan veri dosyalarınızı yükleyin.</p>

                <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                    <a class="primary-button inline-flex h-12 min-w-52 items-center justify-center rounded-lg px-7 font-semibold"
                       asp-controller="Home" asp-action="Index">
                        Yeni Analiz Oluştur
                    </a>
                </div>
            </div>
        </section>
    }
    else if (Model.Status == ReportWorkspaceStatus.Draft)
    {
        <section class="glass-panel mt-9 flex min-h-[27rem] flex-col justify-center overflow-hidden rounded-[2rem] px-6 py-11 sm:px-10 lg:px-12"
                 aria-labelledby="draft-report-heading"
                 data-ready-file-count="@Model.ReadyFileCount">
            <span class="glass-panel-ornament" aria-hidden="true"></span>
            <div class="flex flex-col gap-7 lg:flex-row lg:items-start lg:justify-between">
                <div class="flex max-w-3xl items-start gap-4 sm:gap-5">
                    <div class="shrink-0 text-brand-400"
                         role="progressbar"
                         aria-label="Analiz için hazır veri dosyaları"
                         aria-valuemin="0"
                         aria-valuemax="2"
                         aria-valuenow="@Model.ReadyFileCount"
                         aria-valuetext="@($"{Model.ReadyFileCount} / 2 dosya hazır")">
                        <svg class="h-14 w-14 -rotate-90" viewBox="0 0 48 48" aria-hidden="true">
                            <circle cx="24" cy="24" r="20" pathLength="100" fill="none" stroke="currentColor" stroke-width="5" class="text-step-border"></circle>
                            <circle cx="24" cy="24" r="20" pathLength="100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-dasharray="100" stroke-dashoffset="@readyFileProgressOffset" class="text-brand-400 transition-[stroke-dashoffset] duration-300"></circle>
                        </svg>
                    </div>

                    <div class="min-w-0">
                        <h2 id="draft-report-heading" class="text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">Analiz henüz tamamlanmadı</h2>
                        <p class="mt-1 text-base text-slate-300">@Model.ReadyFileCount / 2 dosya hazır</p>

                        @if (Model.HasBothFiles)
                        {
                            <p class="mt-3 text-sm leading-relaxed text-slate-400 sm:text-base">Aylık Varlık Verisi ve Yİ-ÜFE Endeks Verisi dosyalarınız hazır. Rapor dönemini seçmek ve analizi tamamlamak için Ana Sayfa’daki akışa devam edin.</p>
                        }
                        else if (Model.AssetValues is null)
                        {
                            <p class="mt-3 text-sm leading-relaxed text-slate-400 sm:text-base">Yİ-ÜFE Endeks Verisi dosyanız hazır. Aylık Varlık Verisi dosyanızı yükleyerek finansal etki analizi akışına Ana Sayfa’dan devam edin.</p>
                        }
                        else
                        {
                            <p class="mt-3 text-sm leading-relaxed text-slate-400 sm:text-base">Aylık Varlık Verisi dosyanız hazır. Yİ-ÜFE Endeks Verisi dosyanızı yükleyerek finansal etki analizi akışına Ana Sayfa’dan devam edin.</p>
                        }
                    </div>
                </div>

                <a class="primary-button inline-flex h-12 shrink-0 items-center justify-center rounded-lg px-7 font-semibold"
                   asp-controller="Home" asp-action="Index">
                    Analizi Tamamla
                </a>
            </div>

            <div class="draft-file-list mt-9 overflow-hidden rounded-2xl border border-line-700 bg-surface-800">
                <partial name="_DraftFileStatus" model='new DraftFileStatusViewModel(DraftDataFileKind.AssetValues, "Aylık Varlık Verisi", Model.AssetValues)' />
                <partial name="_DraftFileStatus" model='new DraftFileStatusViewModel(DraftDataFileKind.ProducerPriceIndices, "Yİ-ÜFE Endeks Verisi", Model.ProducerPriceIndices)' />
            </div>
        </section>
    }

    <section class="mt-auto pt-7" aria-labelledby="report-contents-heading">
        <div class="rounded-2xl border border-line-700 bg-surface-900 px-6 py-6">
            <h2 id="report-contents-heading" class="text-xl font-semibold text-ink-900">Finansal etki raporunda neler bulunur?</h2>
            <div class="report-info-grid mt-5 grid sm:grid-cols-2 xl:grid-cols-4">
                <article class="report-info-item flex items-start gap-4 px-3 py-4 sm:px-5">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-icon-line bg-icon-surface text-brand-400" aria-hidden="true">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 5v14h16"></path>
                            <path d="m7 15 4-4 3 2 5-6"></path>
                            <path d="M15.5 7H19v3.5"></path>
                        </svg>
                    </span>
                    <div>
                        <p class="font-medium text-ink-900">Nominal değişim</p>
                        <p class="mt-1 text-sm leading-relaxed text-slate-400">Aylık varlık tutarınızın TL bazındaki aylık ve dönemsel değişimini gösterir.</p>
                    </div>
                </article>
                <article class="report-info-item flex items-start gap-4 px-3 py-4 sm:px-5">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-icon-line bg-icon-surface text-brand-400" aria-hidden="true">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6.25 8A7 7 0 0 1 18 7M18 4v3h-3M17.75 16A7 7 0 0 1 6 17M6 20v-3h3"></path>
                            <path d="M12 8.5v7M14 10c-.45-.75-1.15-1.1-2.05-1.1-1.1 0-1.8.55-1.8 1.35 0 2.15 3.85 1.05 3.85 3.35 0 .9-.8 1.5-2 1.5-.95 0-1.7-.35-2.15-1.05"></path>
                        </svg>
                    </span>
                    <div>
                        <p class="font-medium text-ink-900">Dolarizasyon etkisi</p>
                        <p class="mt-1 text-sm leading-relaxed text-slate-400">Varlığınızın USD/TRY kuru karşısındaki değer değişimini gösterir.</p>
                    </div>
                </article>
                <article class="report-info-item flex items-start gap-4 px-3 py-4 sm:px-5">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-icon-line bg-icon-surface text-brand-400" aria-hidden="true">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3 19 6v5c0 4.5-2.75 7.9-7 10-4.25-2.1-7-5.5-7-10V6z"></path>
                            <path d="M9 15v-3M12 15V9M15 15v-5"></path>
                        </svg>
                    </span>
                    <div>
                        <p class="font-medium text-ink-900">Enflasyon etkisi</p>
                        <p class="mt-1 text-sm leading-relaxed text-slate-400">Varlığınızın Yİ-ÜFE karşısındaki reel değer değişimini gösterir.</p>
                    </div>
                </article>
                <article class="report-info-item flex items-start gap-4 px-3 py-4 sm:px-5">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-icon-line bg-icon-surface text-brand-400" aria-hidden="true">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <path d="M8 3v4M16 3v4M3 10h18M7 14h3M14 14h3M7 17h3M14 17h3"></path>
                        </svg>
                    </span>
                    <div>
                        <p class="font-medium text-ink-900">Aylık detay</p>
                        <p class="mt-1 text-sm leading-relaxed text-slate-400">Her ay için nominal değişimi, dolarizasyon etkisini ve enflasyon etkisini ayrıntılı gösterir.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>
</section>
