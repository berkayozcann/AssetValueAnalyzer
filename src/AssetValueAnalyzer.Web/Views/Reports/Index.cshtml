@using AssetValueAnalyzer.Web.Features.Reports
@model ReportWorkspacePageViewModel

@{
    ViewData["Title"] = "Finansal Etki Analizi Raporu";
    ViewData["ActiveNavigation"] = "Reports";
}

<section class="app-shell pb-12 pt-10 lg:pt-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl">
            <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Finansal Etki Analizi Raporu</h1>
            <p class="mt-4 text-base muted-copy sm:text-lg">Varlığınızın nominal, dolarizasyon ve enflasyon etkilerini tek bir raporda inceleyin.</p>
        </div>

        <partial name="_ExchangeRateCard" model="Model.ExchangeRate" />
    </div>

    @if (Model.Status == ReportWorkspaceStatus.Empty)
    {
        <section class="glass-panel mt-9 overflow-hidden rounded-[2rem] px-6 py-10 text-center sm:px-10 sm:py-14" aria-labelledby="empty-report-heading">
            <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl border border-brand-400/25 bg-brand-500/15 text-brand-400" aria-hidden="true">
                <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M6 2.75h8l4 4V21.25H6z"></path>
                    <path d="M14 2.75v4h4M9 16v-3m3 3V9m3 7v-5"></path>
                </svg>
            </span>
            <h2 id="empty-report-heading" class="mt-6 text-2xl font-semibold tracking-tight text-white sm:text-3xl">Henüz bir finansal etki analizi raporu oluşturulmadı</h2>
            <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed text-slate-300">Varlık ve endeks dosyalarınızı Ana Sayfa’dan yükleyerek yeni bir analiz başlatabilir veya sentetik verilerle hazırlanmış örnek raporu inceleyebilirsiniz.</p>

            <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
                <a class="primary-button inline-flex items-center justify-center rounded-lg px-7 py-3 font-semibold"
                   asp-controller="Reports" asp-action="New">
                    Yeni Analiz Başlat
                </a>
                <a class="secondary-button inline-flex items-center justify-center rounded-lg px-7 py-3 font-medium"
                   asp-controller="Reports" asp-action="Example">
                    Örnek Raporu İncele
                </a>
            </div>
        </section>
    }
    else if (Model.Status == ReportWorkspaceStatus.Draft)
    {
        <section class="glass-panel mt-9 overflow-hidden rounded-[2rem] px-6 py-9 sm:px-10 lg:px-12" aria-labelledby="draft-report-heading">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div class="max-w-2xl">
                    <span class="inline-flex rounded-full border border-accent-300/30 bg-accent-300/10 px-3 py-1 text-xs font-medium text-accent-300">Taslak</span>
                    <h2 id="draft-report-heading" class="mt-4 text-2xl font-semibold tracking-tight text-white sm:text-3xl">Hazırlanmakta olan finansal etki analizi raporunuz var</h2>
                    <p class="mt-3 text-base leading-relaxed text-slate-300">Yüklediğiniz doğrulanmış veriler bu oturum için hazır. Tarih aralığını seçmek ve raporu tamamlamak için Ana Sayfa’daki akışa devam edin.</p>
                </div>

                <a class="primary-button inline-flex shrink-0 items-center justify-center rounded-lg px-7 py-3 font-semibold"
                   asp-controller="Home" asp-action="Index">
                    Ana Sayfada Devam Et
                </a>
            </div>

            <div class="mt-8 grid gap-4 md:grid-cols-2">
                <partial name="_DraftFileStatus" model='new DraftFileStatusViewModel("Varlık Verisi", Model.AssetValues)' />
                <partial name="_DraftFileStatus" model='new DraftFileStatusViewModel("Endeks Verisi", Model.ProducerPriceIndices)' />
            </div>

            @if (!Model.HasBothFiles)
            {
                <p class="mt-5 rounded-xl border border-brand-400/15 bg-brand-500/10 px-5 py-4 text-sm text-slate-300">Finansal hesaplamaya geçebilmek için eksik olan veri dosyasını da yüklemeniz gerekiyor.</p>
            }
        </section>
    }

    <section class="mt-6 rounded-2xl border border-line-700 bg-surface-900/78 px-6 py-6" aria-labelledby="report-contents-heading">
        <h2 id="report-contents-heading" class="text-xl font-semibold text-white">Finansal etki analizi raporunda neler bulunur?</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                <p class="font-medium text-white">Nominal değişim</p>
                <p class="mt-1 text-sm text-slate-400">Varlığın TL bazındaki aylık ve dönemsel değişimi.</p>
            </article>
            <article class="rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                <p class="font-medium text-white">Dolarizasyon etkisi</p>
                <p class="mt-1 text-sm text-slate-400">USD/TRY kuru karşısında varlığın reel değişimi.</p>
            </article>
            <article class="rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                <p class="font-medium text-white">Enflasyon etkisi</p>
                <p class="mt-1 text-sm text-slate-400">Yİ-ÜFE karşısında varlığın değer koruma durumu.</p>
            </article>
            <article class="rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                <p class="font-medium text-white">Aylık detay tablosu</p>
                <p class="mt-1 text-sm text-slate-400">Şartnamedeki 14 kolonu içeren ayrıntılı sonuç görünümü.</p>
            </article>
        </div>
    </section>
</section>
