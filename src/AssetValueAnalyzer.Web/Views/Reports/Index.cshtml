@using AssetValueAnalyzer.Web.Features.Reports
@model ReportWorkspacePageViewModel

@{
    ViewData["Title"] = "Finansal Etki Analizi Raporu";
    ViewData["ActiveNavigation"] = "Reports";
}

<section class="app-shell flex min-h-[calc(100vh-5rem)] flex-col pb-8 pt-10 lg:pt-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl">
            <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Finansal Etki Analizi Raporu</h1>
            <p class="mt-4 text-base muted-copy sm:text-lg">Varlığınızın nominal, dolarizasyon ve enflasyon etkilerini tek bir raporda inceleyin.</p>
        </div>

        <partial name="_ExchangeRateCard" model="Model.ExchangeRate" />
    </div>

    @if (Model.Status == ReportWorkspaceStatus.Empty)
    {
        <section class="glass-panel mt-9 flex min-h-[27rem] flex-col justify-center overflow-hidden rounded-[2rem] px-6 py-12 text-center sm:px-10" aria-labelledby="empty-report-heading">
            <div class="mx-auto flex w-full max-w-4xl flex-col items-center">
                <span class="flex h-20 w-20 items-center justify-center rounded-2xl border border-brand-400/25 bg-brand-500/15 text-brand-400" aria-hidden="true">
                    <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <path d="M6 2.75h8l4 4V21.25H6z"></path>
                        <path d="M14 2.75v4h4M9 16v-3m3 3V9m3 7v-5"></path>
                    </svg>
                </span>
                <h2 id="empty-report-heading" class="mt-7 text-2xl font-semibold tracking-tight text-white sm:text-3xl">Henüz bir finansal etki analizi raporu oluşturulmadı</h2>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">Varlık ve endeks dosyalarınızı Ana Sayfa’dan yükleyerek yeni bir finansal etki analizi başlatabilirsiniz.</p>

                <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                    <a class="primary-button inline-flex h-12 min-w-52 items-center justify-center rounded-lg px-7 font-semibold"
                       asp-controller="Home" asp-action="Index">
                        Yeni Analiz Başlat
                    </a>
                </div>
            </div>
        </section>
    }
    else if (Model.Status == ReportWorkspaceStatus.Draft)
    {
        <section class="glass-panel mt-9 flex min-h-[27rem] flex-col justify-center overflow-hidden rounded-[2rem] px-6 py-11 sm:px-10 lg:px-12" aria-labelledby="draft-report-heading">
            <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
                <div class="max-w-2xl">
                    @if (Model.HasBothFiles)
                    {
                        <h2 id="draft-report-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Finansal etki analizi raporunuz hazırlanıyor</h2>
                        <p class="mt-3 text-base leading-relaxed text-slate-300">Varlık ve endeks verileriniz hazır. Tarih aralığını seçmek ve raporu tamamlamak için Ana Sayfa’daki akışa devam edin.</p>
                    }
                    else if (Model.AssetValues is null)
                    {
                        <h2 id="draft-report-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Raporu tamamlamak için varlık verisi gerekli</h2>
                        <p class="mt-3 text-base leading-relaxed text-slate-300">Endeks veriniz hazır. Varlık dosyanızı yükleyerek finansal etki analizi akışına Ana Sayfa’dan devam edin.</p>
                    }
                    else
                    {
                        <h2 id="draft-report-heading" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Raporu tamamlamak için endeks verisi gerekli</h2>
                        <p class="mt-3 text-base leading-relaxed text-slate-300">Varlık veriniz hazır. Endeks dosyanızı yükleyerek finansal etki analizi akışına Ana Sayfa’dan devam edin.</p>
                    }
                </div>

                <a class="primary-button inline-flex h-12 shrink-0 items-center justify-center rounded-lg px-7 font-semibold"
                   asp-controller="Home" asp-action="Index">
                    Ana Sayfada Devam Et
                </a>
            </div>

            <div class="mt-10 grid auto-rows-fr gap-5 md:grid-cols-2">
                <partial name="_DraftFileStatus" model='new DraftFileStatusViewModel("Varlık Verisi", Model.AssetValues)' />
                <partial name="_DraftFileStatus" model='new DraftFileStatusViewModel("Endeks Verisi", Model.ProducerPriceIndices)' />
            </div>
        </section>
    }

    <section class="mt-auto pt-7" aria-labelledby="report-contents-heading">
        <div class="rounded-2xl border border-line-700 bg-surface-900/78 px-6 py-6">
            <h2 id="report-contents-heading" class="text-xl font-semibold text-white">Finansal etki analizi raporunda neler bulunur?</h2>
            <div class="mt-5 grid auto-rows-fr gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <article class="flex h-full min-h-32 flex-col rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                    <p class="font-medium text-white">Nominal değişim</p>
                    <p class="mt-1 text-sm text-slate-400">Varlığın TL bazındaki aylık ve dönemsel değişimi.</p>
                </article>
                <article class="flex h-full min-h-32 flex-col rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                    <p class="font-medium text-white">Dolarizasyon etkisi</p>
                    <p class="mt-1 text-sm text-slate-400">USD/TRY kuru karşısında varlığın reel değişimi.</p>
                </article>
                <article class="flex h-full min-h-32 flex-col rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                    <p class="font-medium text-white">Enflasyon etkisi</p>
                    <p class="mt-1 text-sm text-slate-400">ÜFE karşısında varlığın değer koruma durumu.</p>
                </article>
                <article class="flex h-full min-h-32 flex-col rounded-xl border border-line-700 bg-canvas-950/55 px-4 py-4">
                    <p class="font-medium text-white">Aylık detay tablosu</p>
                    <p class="mt-1 text-sm text-slate-400">Aylık varlık, kur, dolarizasyon ve enflasyon sonuçlarının ayrıntılı karşılaştırması.</p>
                </article>
            </div>
        </div>
    </section>
</section>
